@page "/Perfil"
@attribute [Authorize]
@inject IMongoSugerenciaData sugerenciaData
@inject IUserData userData
@inject NavigationManager navManager
@inject AuthenticationStateProvider authProvider

<PageTitle>Mi perfil · Sugerencias</PageTitle>

<div class="narrow">
    <div class="page-head">
        <div>
            <h1>Mi perfil</h1>
            <p>@loggedInUsuario?.DisplayName</p>
        </div>
        <a class="btn" href="MicrosoftIdentity/Account/EditProfile">Editar perfil</a>
    </div>

    @if (sugerido is null)
    {
        <div class="card card-pad" aria-busy="true">
            <div class="skeleton sk-line" style="width:40%"></div>
            <div class="skeleton sk-line" style="width:80%"></div>
            <div class="skeleton sk-line" style="width:60%"></div>
        </div>
    }
    else if (sugerido.Count == 0)
    {
        <div class="card empty">
            <h2>Todavía no hiciste sugerencias</h2>
            <p>Cuando propongas un tema, vas a poder seguir su estado desde acá.</p>
            <p style="margin-top:18px"><a class="btn btn-primary" href="Crear">Nueva sugerencia</a></p>
        </div>
    }
    else
    {
        <div class="stack">
            @Seccion("Esperando aprobación", "Un administrador todavía no las revisó.", pendientes)
            @Seccion("Publicadas", "Están visibles y se pueden votar.", aprobadas)
            @Seccion("Archivadas", "Ya no aparecen en el listado.", archivadas)
            @Seccion("No aprobadas", "Un administrador decidió no publicarlas.", rechazadas)
        </div>
    }
</div>

@code {
    private RenderFragment Seccion(string titulo, string ayuda, List<SugerenciaModel> lista) => __builder =>
    {
        if (lista is null || lista.Count == 0)
        {
            return;
        }

        <section class="card card-pad">
            <h2 class="panel-title">@titulo (@lista.Count)</h2>
            <p class="panel-help">@ayuda</p>
            @foreach (var s in lista)
            {
                <div class="row-item" @key="s.Id">
                    <a class="row-title" href="@($"Detalles/{s.Id}")">@s.Sugerencia</a>
                    <div class="meta">
                        <EstadoBadge Sugerencia="s" />
                        <span class="badge">@s.Categoria?.CategoriaNombre</span>
                        <span>@(s.VotosDeUsuarios?.Count ?? 0) votos · @s.FechaCreacion.ToString("d MMM yyyy", Cultura.Es)</span>
                    </div>
                    @if (s.SugerenciaEstado is not null)
                    {
                        <p class="row-note"><NotaAdminTexto Sugerencia="s" /></p>
                    }
                </div>
            }
        </section>
    };
}
