@page "/"
@implements IDisposable
@inject AuthenticationStateProvider authProvider
@inject ICategoryData categoryData
@inject IStatusData statusData
@inject IMongoSugerenciaData sugerenciaData
@inject IUserData userData
@inject NavigationManager navManager
@inject ProtectedSessionStorage sessionStorage
@inject NotificadorSugerencias notificador

<PageTitle>Sugerencias de cursos</PageTitle>

<div class="page-head">
    <div>
        <h1>Sugerencias de cursos</h1>
        <p>Proponé temas para nuevos cursos y votá los que más te interesen.</p>
    </div>
    <button class="btn btn-primary" @onclick="CargarPaginaCrear"><Icon Name="plus" /> Nueva sugerencia</button>
</div>

<div class="toolbar">
    <div class="segmented" role="group" aria-label="Orden">
        <button aria-pressed="@(isSortedByNew ? "true" : "false")" @onclick="(() => OrderByNew(true))">Nuevas</button>
        <button aria-pressed="@(isSortedByNew ? "false" : "true")" @onclick="(() => OrderByNew(false))">Populares</button>
    </div>
    <div class="input-search">
        <Icon Name="search" />
        <input type="search" class="input" placeholder="Buscar sugerencias" aria-label="Buscar sugerencias"
               value="@textoBusqueda" @oninput="(txt => InputBusqueda((string)txt.Value))" />
    </div>
    <select class="select" aria-label="Categoría" value="@categoriaSeleccionada"
            @onchange="(e => OnCategoriaClick((string)e.Value))">
        <option value="@SugerenciaFiltros.TodasLasCategorias">Categorías</option>
        @foreach (var c in categorias ?? [])
        {
            <option value="@c.CategoriaNombre">@c.CategoriaNombre</option>
        }
    </select>
    <select class="select" aria-label="Estado" value="@estadoSeleccionado"
            @onchange="(e => OnEstadoClick((string)e.Value))">
        <option value="@SugerenciaFiltros.TodosLosEstados">Estados</option>
        @foreach (var e in estados ?? [])
        {
            <option value="@e.EstadoNombre">@EstadoBadge.Nombre(e.EstadoNombre)</option>
        }
    </select>
</div>

@if (sugerencias is null)
{
    <div class="list" aria-busy="true" aria-label="Cargando sugerencias">
        @for (int i = 0; i < 4; i++)
        {
            <div class="item">
                <div class="skeleton sk-vote"></div>
                <div>
                    <div class="skeleton sk-line" style="width:55%;margin-top:4px"></div>
                    <div class="skeleton sk-line" style="width:85%"></div>
                    <div class="skeleton sk-line" style="width:30%;margin-top:14px"></div>
                </div>
            </div>
        }
    </div>
}
else if (sugerencias.Count == 0)
{
    <div class="card empty">
        <h2>No hay sugerencias con estos filtros</h2>
        <p>Probá con otra búsqueda o proponé el tema que estás buscando.</p>
    </div>
}
else
{
    <div class="result-count" aria-live="polite">@sugerencias.Count @(sugerencias.Count == 1 ? "sugerencia" : "sugerencias")</div>
    <div class="list">
        <Virtualize Items="@sugerencias" Context="s" OverscanCount="10">
            <article class="item" @key="s.Id">
                <VotoBoton Sugerencia="s" UsuarioId="@loggedInUsuario?.Id" OnClick="(() => Votar(s))" />
                <div class="item-body">
                    <a class="item-title" href="@($"Detalles/{s.Id}")">@s.Sugerencia</a>
                    @if (string.IsNullOrWhiteSpace(s.Descripcion) == false)
                    {
                        <p class="item-desc">@s.Descripcion</p>
                    }
                    <div class="meta">
                        <EstadoBadge Sugerencia="s" />
                        <span class="badge">@s.Categoria?.CategoriaNombre</span>
                        <span>@s.Autor?.DisplayName · @s.FechaCreacion.ToString("d MMM yyyy", Cultura.Es)</span>
                        <AuthorizeView Policy="Admin">
                            <span class="meta-actions">
                                @if (archivandoSugerencia?.Id == s.Id)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="ArchivarSugerencia">Confirmar archivo</button>
                                    <button class="btn btn-sm btn-ghost" @onclick="(() => archivandoSugerencia = null)">Cancelar</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-ghost" @onclick="(() => archivandoSugerencia = s)">Archivar</button>
                                }
                            </span>
                        </AuthorizeView>
                    </div>
                </div>
            </article>
        </Virtualize>
    </div>
}
