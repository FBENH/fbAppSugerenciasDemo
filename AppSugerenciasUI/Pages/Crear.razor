@page "/Crear"
@attribute [Authorize]
@implements IDisposable
@using AppSugerenciasUI.Components
@using AppSugerenciasUI.Models
@inject AuthenticationStateProvider authProvider
@inject ICategoryData categoriaData
@inject IMongoSugerenciaData sugerenciaData
@inject IUserData userData
@inject NavigationManager navManager

<PageTitle>Nueva sugerencia · Sugerencias</PageTitle>

<div class="narrow">
    <a class="back-link" href="/"><Icon Name="back" /> Todas las sugerencias</a>
    <div class="page-head">
        <div>
            <h1>Nueva sugerencia</h1>
            <p>Un administrador la revisa antes de publicarla para que el resto pueda votarla.</p>
        </div>
    </div>

    @if (categorias is null)
    {
        <div class="card card-pad" aria-busy="true">
            <div class="skeleton sk-line" style="width:30%"></div>
            <div class="skeleton sk-line" style="height:38px"></div>
            <div class="skeleton sk-line" style="width:30%;margin-top:24px"></div>
            <div class="skeleton sk-line" style="height:60px"></div>
        </div>
    }
    else
    {
        <div class="card card-pad">
            <EditForm Model="sugerencia" OnValidSubmit="CrearSugerencia">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="field">
                    <label class="field-label" for="sugerencia-text">Tema</label>
                    <span class="field-help">Contá qué te gustaría aprender, en una línea.</span>
                    <InputText class="input" id="sugerencia-text" maxlength="75" autocomplete="off"
                               @bind-Value="sugerencia.Sugerencia" @oninput="AlEscribirTitulo" />
                    <div class="field-count">@largoTitulo/75</div>
                </div>

                @if (parecidas.Count > 0)
                {
                    <div class="status-panel" style="margin:-6px 0 22px" aria-live="polite">
                        <div class="section-title">Puede que ya exista</div>
                        <p style="font-size:.9rem">Si alguna de estas es lo que buscás, votala en lugar de crear una nueva.</p>
                        @foreach (var p in parecidas)
                        {
                            <div class="meta" style="margin-top:4px">
                                <a href="@($"Detalles/{p.Id}")" target="_blank">@p.Sugerencia</a>
                                <span>@(p.VotosDeUsuarios?.Count ?? 0) votos</span>
                                <EstadoBadge Sugerencia="p" />
                            </div>
                        }
                    </div>
                }

                <div class="field">
                    <span class="field-label" id="categoria-label">Categoría</span>
                    <MyInputRadioGroup @bind-Value="sugerencia.CategoriaId">
                        <div class="choice-grid" role="radiogroup" aria-labelledby="categoria-label">
                            @foreach (var c in categorias)
                            {
                                <label class="choice">
                                    <InputRadio Value="@c.Id" />
                                    <span class="choice-body">
                                        <strong>@c.CategoriaNombre</strong>
                                        <span>@c.CategoriaDescripcion</span>
                                    </span>
                                </label>
                            }
                        </div>
                    </MyInputRadioGroup>
                </div>

                <div class="field">
                    <label class="field-label" for="descripcion">Descripción <span class="field-help">(opcional)</span></label>
                    <InputTextArea class="textarea" id="descripcion" maxlength="500" @bind-Value="sugerencia.Descripcion" />
                </div>

                <div class="row-actions">
                    <a class="btn btn-ghost" href="/">Cancelar</a>
                    <button class="btn btn-primary" type="submit" disabled="@enviando">Enviar sugerencia</button>
                </div>
            </EditForm>
        </div>
    }
</div>
