<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "up": <path d="m6 15 6-6 6 6" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /> break;
        case "back": <path d="M19 12H5" /><path d="m12 19-7-7 7-7" /> break;
        case "plus": <path d="M12 5v14" /><path d="M5 12h14" /> break;
        case "pencil": <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /> break;
        case "check": <path d="M20 6 9 17l-5-5" /> break;
        case "x": <path d="M18 6 6 18" /><path d="m6 6 12 12" /> break;
        case "external": <path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; }

    [Parameter]
    public string Class { get; set; }
}
