@inherits LayoutComponentBase

<PageTitle>Sugerencias</PageTitle>

<div class="page">
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" href="/">
                <span class="brand-mark"><Icon Name="logo" /></span>
                <span class="brand-name">Sugerencias</span>
            </a>
            <nav class="nav" aria-label="Principal">
                <LoginDisplay />
            </nav>
        </div>
    </header>

    <main class="container">
        @Body
    </main>

    <footer class="footer">
        <div class="container">
            <span>Demo de una app de sugerencias de cursos, hecha con Blazor y MongoDB.</span>
            <a href="https://github.com/FBENH/fbAppSugerenciasDemo" target="_blank" rel="noopener noreferrer">Código en GitHub</a>
        </div>
    </footer>
</div>
